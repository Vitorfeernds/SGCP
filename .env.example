#Exemplo de arquivo .env para configuração do banco de dados MongoDB.
#Este arquivo NÃO deve ser versionado (adicione-o ao .gitignore) para evitarvazamento de credenciais sensíveis. 
#Copie este modelo para um arquivo .env real e preencha os valores conforme necessário.

MONGO_URI=mongodb://localhost:27017
MONGO_DB=sgcp